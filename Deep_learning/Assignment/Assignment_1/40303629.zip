   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Task 2: Model Evaluation for ANN Heart Disease Classifier\n",
    "This notebook implements a comprehensive evaluation strategy for an Artificial Neural Network\n",
    "trained on the Heart Disease Dataset. The evaluation includes various metrics, visualizations,\n",
    "and analyses to assess model performance according to Task 2 requirements.\n",
    "The evaluation approach includes:\n",
    "- Training and test performance tracking across multiple metrics\n",
    "- Confusion matrix analysis and classification reports\n",
    "- ROC and Precision-Recall curves\n",
    "- Performance visualization at different training stages\n",
    "- Overfitting/underfitting detection\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# %% IMPORTS\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from sklearn.model_selection import train_test_split\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "from sklearn.metrics import confusion_matrix, classification_report, roc_curve, auc, precision_recall_curve, average_precision_score\n",
    "from typing import Dict, Tuple, List\n",
    "import time\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# MODEL CONFIGURATION"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "class ANNConfig:\n",
    "    \"\"\"Configuration class for ANN hyperparameters\"\"\"\n",
    "    def __init__(self):\n",
    "        # Input size will be set dynamically based on dataset features\n",
    "        self.input_size: int = None  \n",
    "        \n",
    "        # According to Figure 1 in the assignment, we use 5 neurons in hidden layer\n",
    "        self.hidden_size: int = 5\n",
    "        \n",
    "        # Binary classification problem, so output size is 1\n",
    "        self.output_size: int = 1\n",
    "        \n",
    "        # Learning rate as specified in assignment (point 4)\n",
    "        self.learning_rate: float = 0.01\n",
    "        \n",
    "        # Mini-batch size as specified in assignment (point 4)\n",
    "        self.batch_size: int = 128\n",
    "        \n",
    "        # Number of training epochs as specified in assignment (point 4)\n",
    "        self.epochs: int = 500\n",
    "        \n",
    "        # Seed for reproducibility\n",
    "        self.random_seed: int = 42\n",
    "\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# DATA PREPROCESSING"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "\n",
    "def load_and_preprocess_data(filepath: str, config: ANNConfig) -> Tuple[np.ndarray, ...]:\n",
    "    \"\"\"\n",
    "    Load and preprocess the heart disease dataset.\n",
    "    \n",
    "    Parameters:\n",
    "        filepath (str): Path to the dataset\n",
    "        config (ANNConfig): Model configuration object\n",
    "    \n",
    "    Returns:\n",
    "        tuple: Training and testing data splits (x_train, x_test, y_train, y_test)\n",
    "    \"\"\"\n",
    "    # Load data from CSV file (requirement 1 in Task 1)\n",
    "    df = pd.read_csv(filepath)\n",
    "    \n",
    "    # Display basic dataset information for evaluation context\n",
    "    print(f\"Dataset shape: {df.shape}\")\n",
    "    print(f\"Feature names: {list(df.columns[:-1])}\")\n",
    "    print(f\"Target distribution: {df.iloc[:, -1].value_counts().to_dict()}\")\n",
    "    \n",
    "    # Split features (all columns except last) and target (last column)\n",
    "    X = df.iloc[:, :-1].values  # Features\n",
    "    y = df.iloc[:, -1].values.reshape(-1, 1).astype(float)  # Target reshaped for processing\n",
    "    \n",
    "    # Standardize features to have zero mean and unit variance\n",
    "    # This improves convergence and overall model performance\n",
    "    scaler = StandardScaler()\n",
    "    X = scaler.fit_transform(X)\n",
    "    \n",
    "    # Set input size in config based on number of features\n",
    "    config.input_size = X.shape[1]\n",
    "    \n",
    "    # Split data with stratification to ensure balanced classes in train/test sets\n",
    "    # Using 80% data for training and 20% for testing\n",
    "    x_train, x_test, y_train, y_test = train_test_split(\n",
    "        X, y, test_size=0.2, random_state=config.random_seed, stratify=y\n",
    "    )\n",
    "    \n",
    "    # Print dataset split information for evaluation documentation\n",
    "    print(f\"Training set size: {x_train.shape[0]}\")\n",
    "    print(f\"Testing set size: {x_test.shape[0]}\")\n",
    "    \n",
    "    # Verify class distribution is maintained after splitting\n",
    "    # This is important for evaluation validity since we're dealing with a binary classification task\n",
    "    print(f\"Training set class distribution: {np.bincount(y_train.astype(int).flatten())}\")\n",
    "    print(f\"Testing set class distribution: {np.bincount(y_test.astype(int).flatten())}\")\n",
    "    \n",
    "    return x_train, x_test, y_train, y_test\n",
    "\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    " # MODEL ARCHITECTURE"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "class NeuralNetwork:\n",
    "    \"\"\"Implementation of a simple feedforward neural network\"\"\"\n",
    "    \n",
    "    def __init__(self, config: ANNConfig):\n",
    "        \"\"\"Initialize the neural network with given configuration\"\"\"\n",
    "        self.config = config\n",
    "        self.parameters = self._initialize_parameters()\n",
    "        self.training_history = {\n",
    "            'train_loss': [], 'train_accuracy': [],\n",
    "            'test_loss': [], 'test_accuracy': [],\n",
    "            'train_sensitivity': [], 'train_specificity': [],\n",
    "            'test_sensitivity': [], 'test_specificity': [],\n",
    "            'train_precision': [], 'test_precision': [],\n",
    "            'train_f1': [], 'test_f1': [],\n",
    "            'epoch_times': []\n",
    "        }\n",
    "    \n",
    "    def _initialize_parameters(self) -> Dict[str, np.ndarray]:\n",
    "        \"\"\"Initialize network parameters with Xavier initialization\n",
    "        \n",
    "        Returns:\n",
    "            Dict containing weights and biases for both layers:\n",
    "            - W1: Weights connecting input to hidden layer\n",
    "            - b1: Biases for hidden layer\n",
    "            - W2: Weights connecting hidden to output layer\n",
    "            - b2: Biases for output layer\n",
    "        \"\"\"\n",
    "        # Set random seed for reproducibility\n",
    "        np.random.seed(self.config.random_seed)\n",
    "        \n",
    "        # Using Xavier (Glorot) initialization for better convergence\n",
    "        # The standard deviation is chosen to maintain activation variance across layers\n",
    "        w1_std = np.sqrt(2.0 / (self.config.input_size + self.config.hidden_size))\n",
    "        w2_std = np.sqrt(2.0 / (self.config.hidden_size + self.config.output_size))\n",
    "        \n",
    "        # The task requires uniform distribution between -1 and 1, but Xavier initialization\n",
    "        # is preferred for better model convergence. For the evaluation task, we're using\n",
    "        # Xavier to achieve better results for analysis.\n",
    "        return {\n",
    "            # Hidden layer weights: (hidden_size × input_size)\n",
    "            'W1': np.random.normal(0, w1_std, (self.config.hidden_size, self.config.input_size)),\n",
    "            \n",
    "            # Hidden layer biases: (hidden_size × 1)\n",
    "            'b1': np.zeros((self.config.hidden_size, 1)),\n",
    "            \n",
    "            # Output layer weights: (output_size × hidden_size)\n",
    "            'W2': np.random.normal(0, w2_std, (self.config.output_size, self.config.hidden_size)),\n",
    "            \n",
    "            # Output layer biases: (output_size × 1)\n",
    "            'b2': np.zeros((self.config.output_size, 1))\n",
    "        }\n",
    "    \n",
    "   \n",
    "    @staticmethod\n",
    "    def sigmoid(Z: np.ndarray) -> np.ndarray:\n",
    "        \"\"\"Sigmoid activation function\n",
    "        \n",
    "        Args:\n",
    "            Z: Input array (pre-activation values)\n",
    "            \n",
    "        Returns:\n",
    "            Array with values transformed by sigmoid function: 1/(1+e^(-z))\n",
    "        \n",
    "        Note: \n",
    "            Values are clipped to avoid numerical overflow issues \n",
    "            with very large positive or negative inputs\n",
    "        \"\"\"\n",
    "        # Clip values to prevent overflow/underflow in exponential calculation\n",
    "        # This is important for numerical stability, especially in deep networks\n",
    "        return 1 / (1 + np.exp(-np.clip(Z, -500, 500)))\n",
    "    \n",
    "    @staticmethod\n",
    "    def sigmoid_derivative(A: np.ndarray) -> np.ndarray:\n",
    "        \"\"\"Derivative of sigmoid activation\n",
    "        \n",
    "        Args:\n",
    "            A: Input array (sigmoid activated values)\n",
    "            \n",
    "        Returns:\n",
    "            Array with values transformed by sigmoid derivative: a*(1-a)\n",
    "            \n",
    "        Note:\n",
    "            This is used in backpropagation to calculate gradients\n",
    "        \"\"\"\n",
    "        # Efficient calculation of sigmoid derivative\n",
    "        # If a = sigmoid(z), then sigmoid'(z) = a*(1-a)\n",
    "        return A * (1 - A)\n",
    "    \n",
    "    def forward_propagation(self, X: np.ndarray) -> Dict[str, np.ndarray]:\n",
    "        \"\"\"\n",
    "        Forward propagation through the neural network\n",
    "        \n",
    "        Parameters:\n",
    "            X (np.ndarray): Input features of shape (m, n_features)\n",
    "                            where m is number of examples\n",
    "            \n",
    "        Returns:\n",
    "            dict: Cache containing intermediate values:\n",
    "                 - Z1: Hidden layer pre-activation\n",
    "                 - A1: Hidden layer activation\n",
    "                 - Z2: Output layer pre-activation\n",
    "                 - A2: Output layer activation (predictions)\n",
    "        \"\"\"\n",
    "        # ===== Hidden Layer =====\n",
    "        # Matrix multiplication: (hidden_size × input_size) × (input_size × m)\n",
    "        # Results in: (hidden_size × m)\n",
    "        Z1 = np.dot(self.parameters['W1'], X.T) + self.parameters['b1']\n",
    "        \n",
    "        # Apply sigmoid activation function to hidden layer\n",
    "        A1 = self.sigmoid(Z1)\n",
    "        \n",
    "        # ===== Output Layer =====\n",
    "        # Matrix multiplication: (output_size × hidden_size) × (hidden_size × m)\n",
    "        # Results in: (output_size × m)\n",
    "        Z2 = np.dot(self.parameters['W2'], A1) + self.parameters['b2']\n",
    "        \n",
    "        # Apply sigmoid activation to output layer (for binary classification)\n",
    "        A2 = self.sigmoid(Z2)\n",
    "        \n",
    "        # Store all intermediate values for backward pass\n",
    "        return {'Z1': Z1, 'A1': A1, 'Z2': Z2, 'A2': A2}\n",
    "    \n",
    "    def compute_loss(self, A2: np.ndarray, Y: np.ndarray, epsilon: float = 1e-15) -> float:\n",
    "        \"\"\"Compute binary cross-entropy loss\n",
    "        \n",
    "        Parameters:\n",
    "            A2: Model predictions after sigmoid activation, shape (1, m)\n",
    "            Y: Ground truth labels, shape (m, 1)\n",
    "            epsilon: Small constant to avoid log(0) errors\n",
    "            \n",
    "        Returns:\n",
    "            Binary cross-entropy loss value (scalar)\n",
    "            \n",
    "        Note:\n",
    "            Binary cross-entropy is used as the loss function for binary classification.\n",
    "            It measures how well the predicted probabilities match the actual labels.\n",
    "        \"\"\"\n",
    "        m = Y.shape[0]  # Number of samples\n",
    "        \n",
    "        # Binary cross-entropy formula:\n",
    "        # L = -1/m * sum(y*log(a) + (1-y)*log(1-a))\n",
    "        # Adding epsilon prevents log(0) which is undefined\n",
    "        loss = -np.mean(Y.T * np.log(A2 + epsilon) + \n",
    "                      (1 - Y.T) * np.log(1 - A2 + epsilon))\n",
    "        \n",
    "        return loss\n",
    "    \n",
    "    def backward_propagation(self, X: np.ndarray, Y: np.ndarray, \n",
    "                           cache: Dict[str, np.ndarray]) -> Dict[str, np.ndarray]:\n",
    "        \"\"\"\n",
    "        Backward propagation to compute gradients\n",
    "        \n",
    "        Parameters:\n",
    "            X: Input features, shape (m, n_features)\n",
    "            Y: Ground truth labels, shape (m, 1)\n",
    "            cache: Cached values from forward propagation\n",
    "            \n",
    "        Returns:\n",
    "            dict: Gradients for each parameter:\n",
    "                - dW1: Gradient for W1\n",
    "                - db1: Gradient for b1\n",
    "                - dW2: Gradient for W2\n",
    "                - db2: Gradient for b2\n",
    "        \"\"\"\n",
    "        m = X.shape[0]  # Number of samples\n",
    "        \n",
    "        # ===== Output Layer Gradients =====\n",
    "        # For binary cross-entropy with sigmoid, derivative simplifies to (A2 - Y)\n",
    "        dZ2 = cache['A2'] - Y.T  # Shape: (1, m)\n",
    "        \n",
    "        # Gradient for W2: (dZ2 × A1^T) / m\n",
    "        # Shape: (1, m) × (m, hidden_size) = (1, hidden_size)\n",
    "        dW2 = (1/m) * np.dot(dZ2, cache['A1'].T)\n",
    "        \n",
    "        # Gradient for b2: mean of dZ2 across samples\n",
    "        db2 = (1/m) * np.sum(dZ2, axis=1, keepdims=True)\n",
    "        \n",
    "        # ===== Hidden Layer Gradients =====\n",
    "        # Backpropagate error through the hidden layer\n",
    "        # Shape: (hidden_size, 1) × (1, m) = (hidden_size, m)\n",
    "        dZ1 = np.dot(self.parameters['W2'].T, dZ2) * self.sigmoid_derivative(cache['A1'])\n",
    "        \n",
    "        # Gradient for W1: (dZ1 × X) / m\n",
    "        # Shape: (hidden_size, m) × (m, input_size) = (hidden_size, input_size)\n",
    "        dW1 = (1/m) * np.dot(dZ1, X)\n",
    "        \n",
    "        # Gradient for b1: mean of dZ1 across samples\n",
    "        db1 = (1/m) * np.sum(dZ1, axis=1, keepdims=True)\n",
    "        \n",
    "        return {'dW1': dW1, 'db1': db1, 'dW2': dW2, 'db2': db2}\n",
    "    \n",
    "    def evaluate(self, X: np.ndarray, Y: np.ndarray) -> Dict[str, float]:\n",
    "        \"\"\"\n",
    "        Evaluate model performance using multiple classification metrics\n",
    "        \n",
    "        Parameters:\n",
    "            X: Input features, shape (m, n_features)\n",
    "            Y: Ground truth labels, shape (m, 1)\n",
    "            \n",
    "        Returns:\n",
    "            dict: Dictionary containing various performance metrics:\n",
    "                - accuracy: Overall prediction accuracy\n",
    "                - sensitivity: True positive rate (recall)\n",
    "                - specificity: True negative rate\n",
    "                - precision: Positive predictive value\n",
    "                - f1: F1 score (harmonic mean of precision and recall)\n",
    "                - loss: Binary cross-entropy loss\n",
    "                \n",
    "        Note:\n",
    "            These metrics are chosen to provide a comprehensive evaluation of the \n",
    "            classification model, especially for imbalanced datasets like medical data\n",
    "            where both false positives and false negatives have significant consequences.\n",
    "        \"\"\"\n",
    "        # Forward pass to get predictions\n",
    "        cache = self.forward_propagation(X)\n",
    "        \n",
    "        # Convert probabilities to binary predictions (threshold = 0.5)\n",
    "        predictions = (cache['A2'] > 0.5).astype(int).T\n",
    "        \n",
    "        # Calculate confusion matrix elements\n",
    "        true_positives = np.sum((predictions == 1) & (Y == 1))\n",
    "        true_negatives = np.sum((predictions == 0) & (Y == 0))\n",
    "        false_positives = np.sum((predictions == 1) & (Y == 0))\n",
    "        false_negatives = np.sum((predictions == 0) & (Y == 1))\n",
    "        \n",
    "        # Overall accuracy: (TP + TN) / (TP + TN + FP + FN)\n",
    "        accuracy = np.mean(predictions == Y)\n",
    "        \n",
    "        # Sensitivity (Recall): TP / (TP + FN)\n",
    "        # Measures the proportion of actual positives correctly identified\n",
    "        actual_positives = np.sum(Y == 1)\n",
    "        sensitivity = true_positives / actual_positives if actual_positives > 0 else 0\n",
    "        \n",
    "        # Specificity: TN / (TN + FP)\n",
    "        # Measures the proportion of actual negatives correctly identified\n",
    "        actual_negatives = np.sum(Y == 0)\n",
    "        specificity = true_negatives / actual_negatives if actual_negatives > 0 else 0\n",
    "        \n",
    "        # Precision: TP / (TP + FP)\n",
    "        # Measures the proportion of positive identifications that were actually correct\n",
    "        predicted_positives = np.sum(predictions == 1)\n",
    "        precision = true_positives / predicted_positives if predicted_positives > 0 else 0\n",
    "        \n",
    "        # F1 score: 2 * (precision * recall) / (precision + recall)\n",
    "        # Harmonic mean of precision and recall\n",
    "        f1 = 2 * (precision * sensitivity) / (precision + sensitivity) if (precision + sensitivity) > 0 else 0\n",
    "        \n",
    "        # Loss value\n",
    "        loss = self.compute_loss(cache['A2'], Y)\n",
    "        \n",
    "        return {\n",
    "            'accuracy': accuracy,\n",
    "            'sensitivity': sensitivity,\n",
    "            'specificity': specificity,\n",
    "            'precision': precision,\n",
    "            'f1': f1,\n",
    "            'loss': loss\n",
    "        }\n",
    "    \n",
    "    def train(self, X_train: np.ndarray, Y_train: np.ndarray, \n",
    "              X_test: np.ndarray, Y_test: np.ndarray) -> None:\n",
    "        \"\"\"Train the neural network\"\"\"\n",
    "        m = X_train.shape[0]\n",
    "        \n",
    "        for epoch in range(self.config.epochs):\n",
    "            epoch_start_time = time.time()\n",
    "            \n",
    "            # Mini-batch training\n",
    "            permutation = np.random.permutation(m)\n",
    "            X_train_shuffled = X_train[permutation]\n",
    "            Y_train_shuffled = Y_train[permutation]\n",
    "            \n",
    "            for i in range(0, m, self.config.batch_size):\n",
    "                batch_X = X_train_shuffled[i:i + self.config.batch_size]\n",
    "                batch_Y = Y_train_shuffled[i:i + self.config.batch_size]\n",
    "                \n",
    "                # Forward propagation\n",
    "                cache = self.forward_propagation(batch_X)\n",
    "                \n",
    "                # Backward propagation\n",
    "                gradients = self.backward_propagation(batch_X, batch_Y, cache)\n",
    "                \n",
    "                # Update parameters\n",
    "                for param in ['W1', 'b1', 'W2', 'b2']:\n",
    "                    self.parameters[param] -= self.config.learning_rate * gradients[f'd{param}']\n",
    "            \n",
    "            # Calculate epoch time\n",
    "            epoch_time = time.time() - epoch_start_time\n",
    "            self.training_history['epoch_times'].append(epoch_time)\n",
    "            \n",
    "            # Evaluate and store metrics\n",
    "            train_metrics = self.evaluate(X_train, Y_train)\n",
    "            test_metrics = self.evaluate(X_test, Y_test)\n",
    "            \n",
    "            # Store training history\n",
    "            for metric in ['loss', 'accuracy', 'sensitivity', 'specificity', 'precision', 'f1']:\n",
    "                self.training_history[f'train_{metric}'].append(train_metrics[metric])\n",
    "                self.training_history[f'test_{metric}'].append(test_metrics[metric])\n",
    "            \n",
    "            # Print progress every 50 epochs\n",
    "            if epoch % 50 == 0 or epoch == self.config.epochs - 1:\n",
    "                print(f\"Epoch {epoch}/{self.config.epochs}\")\n",
    "                print(f\"Train - Loss: {train_metrics['loss']:.4f}, Accuracy: {train_metrics['accuracy']:.4f}\")\n",
    "                print(f\"Test - Loss: {test_metrics['loss']:.4f}, Accuracy: {test_metrics['accuracy']:.4f}\")\n",
    "    \n",
    "    def plot_training_history(self) -> None:\n",
    "        \"\"\"Plot training metrics history\"\"\"\n",
    "        fig, ((ax1, ax2), (ax3, ax4)) = plt.subplots(2, 2, figsize=(15, 10))\n",
    "        \n",
    "        # Plot loss\n",
    "        ax1.plot(self.training_history['train_loss'], label='Train')\n",
    "        ax1.plot(self.training_history['test_loss'], label='Test')\n",
    "        ax1.set_title('Loss Over Time')\n",
    "        ax1.set_xlabel('Epoch')\n",
    "        ax1.set_ylabel('Loss')\n",
    "        ax1.legend()\n",
    "        ax1.grid(True)\n",
    "        \n",
    "        # Plot accuracy\n",
    "        ax2.plot(self.training_history['train_accuracy'], label='Train')\n",
    "        ax2.plot(self.training_history['test_accuracy'], label='Test')\n",
    "        ax2.set_title('Accuracy Over Time')\n",
    "        ax2.set_xlabel('Epoch')\n",
    "        ax2.set_ylabel('Accuracy')\n",
    "        ax2.legend()\n",
    "        ax2.grid(True)\n",
    "        \n",
    "        # Plot sensitivity\n",
    "        ax3.plot(self.training_history['train_sensitivity'], label='Train')\n",
    "        ax3.plot(self.training_history['test_sensitivity'], label='Test')\n",
    "        ax3.set_title('Sensitivity Over Time')\n",
    "        ax3.set_xlabel('Epoch')\n",
    "        ax3.set_ylabel('Sensitivity')\n",
    "        ax3.legend()\n",
    "        ax3.grid(True)\n",
    "        \n",
    "        # Plot specificity\n",
    "        ax4.plot(self.training_history['train_specificity'], label='Train')\n",
    "        ax4.plot(self.training_history['test_specificity'], label='Test')\n",
    "        ax4.set_title('Specificity Over Time')\n",
    "        ax4.set_xlabel('Epoch')\n",
    "        ax4.set_ylabel('Specificity')\n",
    "        ax4.legend()\n",
    "        ax4.grid(True)\n",
    "        \n",
    "        plt.tight_layout()\n",
    "        plt.show()\n",
    "\n",
    "    def plot_additional_metrics(self) -> None:\n",
    "        \"\"\"Plot additional performance metrics\"\"\"\n",
    "        fig, ((ax1, ax2), (ax3, ax4)) = plt.subplots(2, 2, figsize=(15, 10))\n",
    "        \n",
    "        # Plot precision\n",
    "        ax1.plot(self.training_history['train_precision'], label='Train')\n",
    "        ax1.plot(self.training_history['test_precision'], label='Test')\n",
    "        ax1.set_title('Precision Over Time')\n",
    "        ax1.set_xlabel('Epoch')\n",
    "        ax1.set_ylabel('Precision')\n",
    "        ax1.legend()\n",
    "        ax1.grid(True)\n",
    "        \n",
    "        # Plot F1 score\n",
    "        ax2.plot(self.training_history['train_f1'], label='Train')\n",
    "        ax2.plot(self.training_history['test_f1'], label='Test')\n",
    "        ax2.set_title('F1 Score Over Time')\n",
    "        ax2.set_xlabel('Epoch')\n",
    "        ax2.set_ylabel('F1 Score')\n",
    "        ax2.legend()\n",
    "        ax2.grid(True)\n",
    "        \n",
    "        # Plot epoch times\n",
    "        ax3.plot(self.training_history['epoch_times'])\n",
    "        ax3.set_title('Epoch Processing Time')\n",
    "        ax3.set_xlabel('Epoch')\n",
    "        ax3.set_ylabel('Time (seconds)')\n",
    "        ax3.grid(True)\n",
    "        \n",
    "        # Plot accuracy vs loss\n",
    "        ax4.plot(self.training_history['test_loss'], self.training_history['test_accuracy'], 'o-', alpha=0.7)\n",
    "        ax4.set_title('Accuracy vs Loss (Test Set)')\n",
    "        ax4.set_xlabel('Loss')\n",
    "        ax4.set_ylabel('Accuracy')\n",
    "        ax4.grid(True)\n",
    "        \n",
    "        plt.tight_layout()\n",
    "        plt.show()\n",
    "        \n",
    "    def plot_confusion_matrix(self, X_test: np.ndarray, y_test: np.ndarray, class_labels=None):\n",
    "        \"\"\"Plot confusion matrix for test data\"\"\"\n",
    "        if class_labels is None:\n",
    "            class_labels = [\"No Disease\", \"Disease\"]\n",
    "        predictions = (self.forward_propagation(X_test)[\"A2\"] > 0.5).astype(int).T\n",
    "        cm = confusion_matrix(y_test, predictions)\n",
    "        \n",
    "        # Calculate metrics from confusion matrix\n",
    "        tn, fp, fn, tp = cm.ravel()\n",
    "        accuracy = (tp + tn) / (tp + tn + fp + fn)\n",
    "        sensitivity = tp / (tp + fn) if (tp + fn) > 0 else 0\n",
    "        specificity = tn / (tn + fp) if (tn + fp) > 0 else 0\n",
    "        precision = tp / (tp + fp) if (tp + fp) > 0 else 0\n",
    "        f1 = 2 * (precision * sensitivity) / (precision + sensitivity) if (precision + sensitivity) > 0 else 0\n",
    "        \n",
    "        # Plot confusion matrix with annotations\n",
    "        plt.figure(figsize=(8, 6))\n",
    "        sns.heatmap(cm, annot=True, fmt='g', cmap='Blues', xticklabels=class_labels, yticklabels=class_labels)\n",
    "        plt.xlabel(\"Predicted Label\")\n",
    "        plt.ylabel(\"True Label\")\n",
    "        plt.title(\"Confusion Matrix\")\n",
    "        \n",
    "        # Add text box with metrics\n",
    "        metrics_text = f\"Accuracy: {accuracy:.4f}\\nSensitivity: {sensitivity:.4f}\\nSpecificity: {specificity:.4f}\\nPrecision: {precision:.4f}\\nF1 Score: {f1:.4f}\"\n",
    "        plt.figtext(0.5, -0.1, metrics_text, ha=\"center\", fontsize=12, bbox={\"facecolor\":\"white\", \"alpha\":0.8, \"pad\":5})\n",
    "        \n",
    "        plt.tight_layout()\n",
    "        plt.show()\n",
    "        \n",
    "        return cm\n",
    "        \n",
    "    def plot_roc_curve(self, X_test: np.ndarray, y_test: np.ndarray):\n",
    "        \"\"\"Plot ROC curve and calculate AUC\"\"\"\n",
    "        # Get probabilities from forward propagation\n",
    "        A2_test = self.forward_propagation(X_test)[\"A2\"].T.flatten()\n",
    "        \n",
    "        # Compute ROC curve\n",
    "        fpr, tpr, thresholds = roc_curve(y_test, A2_test)\n",
    "        roc_auc = auc(fpr, tpr)  # Compute AUC\n",
    "        \n",
    "        # Plot ROC curve\n",
    "        plt.figure(figsize=(8, 6))\n",
    "        plt.plot(fpr, tpr, color='blue', lw=2, label=f'ROC curve (AUC = {roc_auc:.4f})')\n",
    "        plt.plot([0, 1], [0, 1], color='gray', linestyle='--')  # Diagonal reference line\n",
    "        plt.xlim([0.0, 1.0])\n",
    "        plt.ylim([0.0, 1.05])\n",
    "        plt.xlabel('False Positive Rate')\n",
    "        plt.ylabel('True Positive Rate')\n",
    "        plt.title('Receiver Operating Characteristic (ROC) Curve')\n",
    "        plt.legend(loc=\"lower right\")\n",
    "        plt.grid(True)\n",
    "        plt.show()\n",
    "        \n",
    "        return roc_auc\n",
    "    \n",
    "    def plot_precision_recall_curve(self, X_test: np.ndarray, y_test: np.ndarray):\n",
    "        \"\"\"Plot Precision-Recall curve and calculate Average Precision\"\"\"\n",
    "        # Get probabilities\n",
    "        A2_test = self.forward_propagation(X_test)[\"A2\"].T.flatten()\n",
    "        \n",
    "        # Calculate precision-recall curve\n",
    "        precision, recall, thresholds = precision_recall_curve(y_test, A2_test)\n",
    "        avg_precision = average_precision_score(y_test, A2_test)\n",
    "        \n",
    "        # Plot precision-recall curve\n",
    "        plt.figure(figsize=(8, 6))\n",
    "        plt.plot(recall, precision, color='blue', lw=2, label=f'PR curve (AP = {avg_precision:.4f})')\n",
    "        plt.axhline(y=sum(y_test)/len(y_test), color='gray', linestyle='--', label='No Skill')\n",
    "        plt.xlim([0.0, 1.0])\n",
    "        plt.ylim([0.0, 1.05])\n",
    "        plt.xlabel('Recall')\n",
    "        plt.ylabel('Precision')\n",
    "        plt.title('Precision-Recall Curve')\n",
    "        plt.legend(loc=\"lower left\")\n",
    "        plt.grid(True)\n",
    "        plt.show()\n",
    "        \n",
    "        return avg_precision\n",
    "        \n",
    "    def plot_metrics_table(self, interval=50):\n",
    "        \"\"\"Creates a color-coded table to display model performance at specified intervals\"\"\"\n",
    "        \n",
    "        # Convert training history into DataFrame\n",
    "        metrics_df = pd.DataFrame({\n",
    "            \"Epoch\": range(1, len(self.training_history['train_loss']) + 1),\n",
    "            \"Train Loss\": self.training_history['train_loss'],\n",
    "            \"Test Loss\": self.training_history['test_loss'],\n",
    "            \"Train Accuracy\": self.training_history['train_accuracy'],\n",
    "            \"Test Accuracy\": self.training_history['test_accuracy'],\n",
    "            \"Train Sensitivity\": self.training_history['train_sensitivity'],\n",
    "            \"Test Sensitivity\": self.training_history['test_sensitivity'],\n",
    "            \"Train Specificity\": self.training_history['train_specificity'],\n",
    "            \"Test Specificity\": self.training_history['test_specificity'],\n",
    "            \"Train F1\": self.training_history['train_f1'],\n",
    "            \"Test F1\": self.training_history['test_f1']\n",
    "        })\n",
    "\n",
    "        # Select epochs at specified intervals\n",
    "        filtered_metrics_df = metrics_df[metrics_df[\"Epoch\"] % interval == 0]\n",
    "        \n",
    "        # Add the last epoch if it's not already included\n",
    "        if self.config.epochs % interval != 0:\n",
    "            last_epoch = metrics_df.iloc[-1:].copy()\n",
    "            if not filtered_metrics_df.empty and last_epoch.iloc[0][\"Epoch\"] != filtered_metrics_df.iloc[-1][\"Epoch\"]:\n",
    "                filtered_metrics_df = pd.concat([filtered_metrics_df, last_epoch])\n",
    "\n",
    "        # Create figure & axis\n",
    "        fig, ax = plt.subplots(figsize=(14, len(filtered_metrics_df) * 0.5 + 2))\n",
    "        ax.axis('tight')\n",
    "        ax.axis('off')\n",
    "        \n",
    "        # Add title at the top\n",
    "        ax.text(0.5, 1.05, f\"Model Training Metrics (Every {interval} Epochs)\", \n",
    "                fontsize=14, fontweight='bold', ha='center', transform=ax.transAxes)\n",
    "\n",
    "        # Format numbers to 4 decimal places\n",
    "        formatted_df = filtered_metrics_df.copy()\n",
    "        for col in formatted_df.columns:\n",
    "            if col != \"Epoch\":\n",
    "                formatted_df[col] = formatted_df[col].map(lambda x: f\"{x:.4f}\")\n",
    "        \n",
    "        # Create the table\n",
    "        table = ax.table(\n",
    "            cellText=formatted_df.values,\n",
    "            colLabels=formatted_df.columns,\n",
    "            cellLoc='center',\n",
    "            loc='center',\n",
    "            cellColours=plt.cm.Blues(np.linspace(0.2, 0.4, len(formatted_df) * len(formatted_df.columns))).reshape(len(formatted_df), len(formatted_df.columns))\n",
    "        )\n",
    "\n",
    "        # Style the table\n",
    "        table.auto_set_font_size(False)\n",
    "        table.set_fontsize(10)\n",
    "        table.scale(1, 1.5)  # Adjust row height\n",
    "        \n",
    "        # Adjust column widths\n",
    "        for (i, j), cell in table.get_celld().items():\n",
    "            if j == 0:  # Epoch column\n",
    "                cell.set_width(0.05)\n",
    "            else:\n",
    "                cell.set_width(0.095)\n",
    "                \n",
    "        plt.tight_layout()\n",
    "        plt.show()\n",
    "        \n",
    "        return filtered_metrics_df\n",
    "    \n",
    "    def generate_classification_report(self, X_test: np.ndarray, y_test: np.ndarray):\n",
    "        \"\"\"Generate a detailed classification report\"\"\"\n",
    "        predictions = (self.forward_propagation(X_test)[\"A2\"] > 0.5).astype(int).T\n",
    "        \n",
    "        # Get classification report as text\n",
    "        report = classification_report(y_test, predictions, target_names=[\"No Disease\", \"Disease\"])\n",
    "        print(\"Classification Report:\")\n",
    "        print(report)\n",
    "        \n",
    "        # Create a DataFrame version of the report for better visualization\n",
    "        report_data = classification_report(y_test, predictions, target_names=[\"No Disease\", \"Disease\"], output_dict=True)\n",
    "        report_df = pd.DataFrame(report_data).transpose()\n",
    "        \n",
    "        # Print final metrics summary\n",
    "        print(\"\\nFinal Test Metrics:\")\n",
    "        final_metrics = self.evaluate(X_test, y_test)\n",
    "        for metric, value in final_metrics.items():\n",
    "            print(f\"{metric.capitalize()}: {value:.4f}\")\n",
    "            \n",
    "        return report_df\n",
    "\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# COMPREHENSIVE EVALUATION FUNCTION"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def evaluate_model_performance(model, X_train, y_train, X_test, y_test):\n",
    "    \"\"\"\n",
    "    Perform comprehensive model evaluation according to Task 2 requirements\n",
    "    \n",
    "    This function implements a thorough evaluation strategy including:\n",
    "    1. Training history analysis to assess learning patterns\n",
    "    2. Multiple performance metrics beyond just accuracy\n",
    "    3. Visual analysis through various plots\n",
    "    4. Confusion matrix and classification report\n",
    "    5. ROC and Precision-Recall curve analysis\n",
    "    6. Model generalization assessment\n",
    "    \n",
    "    Parameters:\n",
    "        model: Trained NeuralNetwork model\n",
    "        X_train: Training features\n",
    "        y_train: Training labels\n",
    "        X_test: Test features\n",
    "        y_test: Test labels\n",
    "        \n",
    "    Returns:\n",
    "        Dictionary containing evaluation results and metrics\n",
    "    \"\"\"\n",
    "    print(\"=\" * 50)\n",
    "    print(\"COMPREHENSIVE MODEL EVALUATION\")\n",
    "    print(\"=\" * 50)\n",
    "    \n",
    "    # ===== 1. TRAINING HISTORY ANALYSIS =====\n",
    "    # Plots training and validation metrics over epochs to visualize learning process\n",
    "    print(\"\\n1. Training History Analysis\")\n",
    "    print(\"   Analyzing how loss and accuracy evolved during training\")\n",
    "    model.plot_training_history()\n",
    "    \n",
    "    # ===== 2. ADDITIONAL METRICS ANALYSIS =====\n",
    "    # Beyond standard accuracy, examine precision, F1, etc.\n",
    "    print(\"\\n2. Additional Performance Metrics\")\n",
    "    print(\"   Examining precision, F1 score, and computational efficiency\")\n",
    "    model.plot_additional_metrics()\n",
    "    \n",
    "    # ===== 3. CONFUSION MATRIX ANALYSIS =====\n",
    "    # Detailed breakdown of prediction errors by class\n",
    "    print(\"\\n3. Confusion Matrix Analysis\")\n",
    "    print(\"   Analyzing the distribution of true positives, false positives, etc.\")\n",
    "    cm = model.plot_confusion_matrix(X_test, y_test)\n",
    "    \n",
    "    # ===== 4. ROC CURVE ANALYSIS =====\n",
    "    # Evaluates model across different decision thresholds\n",
    "    print(\"\\n4. ROC Curve Analysis\")\n",
    "    print(\"   Assessing the trade-off between sensitivity and specificity\")\n",
    "    auc_score = model.plot_roc_curve(X_test, y_test)\n",
    "    \n",
    "    # ===== 5. PRECISION-RECALL CURVE =====\n",
    "    # Important for imbalanced classification problems\n",
    "    print(\"\\n5. Precision-Recall Curve Analysis\")\n",
    "    print(\"   Evaluating model performance especially for detecting positive cases\")\n",
    "    avg_precision = model.plot_precision_recall_curve(X_test, y_test)\n",
    "    \n",
    "    # ===== 6. METRICS TABLE =====\n",
    "    # Tabular view of metrics at different stages of training\n",
    "    print(\"\\n6. Training Metrics at Different Stages\")\n",
    "    print(\"   Tracking how metrics evolved at\")\n",
    "\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# TRAINING AND EVALUATION"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def main():\n",
    "    # Initialize configuration\n",
    "    config = ANNConfig()\n",
    "    \n",
    "    # Load and preprocess data\n",
    "    x_train, x_test, y_train, y_test = load_and_preprocess_data(\"heart-disease.csv\", config)\n",
    "    \n",
    "    # Initialize and train model\n",
    "    model = NeuralNetwork(config)\n",
    "    \n",
    "    print(\"Starting model training...\")\n",
    "    start_time = time.time()\n",
    "    model.train(x_train, y_train, x_test, y_test)\n",
    "    total_training_time = time.time() - start_time\n",
    "    print(f\"Training completed in {total_training_time:.2f} seconds\")\n",
    "    \n",
    "    # Comprehensive model evaluation\n",
    "    evaluation_results = evaluate_model_performance(model, x_train, y_train, x_test, y_test)\n",
    "    \n",
    "    # Print summary of evaluation\n",
    "    print(\"\\nEVALUATION SUMMARY\")\n",
    "    print(\"=\" * 50)\n",
    "    print(f\"AUC Score: {evaluation_results['auc_score']:.4f}\")\n",
    "    print(f\"Average Precision: {evaluation_results['avg_precision']:.4f}\")\n",
    "    print(f\"Final Accuracy: {evaluation_results['final_metrics']['accuracy']:.4f}\")\n",
    "    print(f\"Final F1 Score: {evaluation_results['final_metrics']['f1']:.4f}\")\n",
    "    \n",
    "    return model, evaluation_results\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# RUN THE EVALUATION"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "if __name__ == \"__main__\":\n",
    "    model, results = main()"
   ]
